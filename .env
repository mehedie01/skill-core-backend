# Django Core Settings
# Set DEBUG to False in production
DEBUG=True
# Generate a new secret key for production
SECRET_KEY=your-secret-key-here
# Comma separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/skillcoredb

# CORS and CSRF Settings (For Frontend Connection)
# Add your Vercel URL here in production
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Superuser Auto-creation (Used in build.sh for Render deployment)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-secure-password